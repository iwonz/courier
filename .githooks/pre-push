#!/bin/sh

set -eu

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/tags/v[0-9]*.[0-9]*.[0-9]*)
      if [ "${COURIER_PUSH_FLOW:-}" != ship ] && [ "${COURIER_RECOVERY:-0}" != 1 ]; then
        printf '%s\n' "Direct push to $remote_ref is blocked." >&2
        printf '%s\n' "Use make ship, or set COURIER_RECOVERY=1 only for a documented recovery." >&2
        exit 1
      fi
      ;;
  esac
done
