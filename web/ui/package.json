{
  "name": "@courier/ui",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "description": "Shared Courier Lit UI primitives, themes, icons, and localization",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/courier-ui.css",
    "./assets/*": "./assets/*"
  },
  "files": [
    "assets/",
    "dist/",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "check:assets": "node ./scripts/check-assets.mjs",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
