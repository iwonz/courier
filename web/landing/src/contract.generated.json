    {
      "name": "auth",
      "syntax": "--auth \u003cnone|basic|password\u003e",
      "valueKind": "enum",
      "choices": [
        "none",
        "basic",
        "password"
      ],
      "placeholder": "none|basic|password",
      "repeatable": false,
      "default": "none",
      "appliesTo": [
        "web-to-path",
        "path-to-web",
        "webhook-to-path",
        "path-to-http"
      ],
      "conflicts": null,
      "requires": null
