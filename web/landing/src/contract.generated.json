      "syntax": "--exclude-regex \u003cregex\u003e",
      "valueKind": "regex",
      "choices": null,
      "placeholder": "regex",
      "repeatable": true,
      "default": "none",
      "appliesTo": [
        "path-to-path",
        "web-to-path",
        "path-to-web",
