        "exclude-from",
        "upload-rate"
      ]
    }
  ],
  "scopeLabels": {
    "local-to-local": {
      "en": "Local path to local path",
      "ru": "Из локального пути в локальный"
    },
    "local-to-ssh": {
      "en": "Local path to SSH path",
      "ru": "Из локального пути в SSH"
    },
    "path-to-http": {
      "en": "Path to HTTP webhook",
      "ru": "Из пути в HTTP webhook"
    },
    "path-to-path": {
      "en": "Path to path",
      "ru": "Из пути в путь"
    },
    "path-to-web": {
      "en": "Path to browser download",
      "ru": "Из пути в браузер"
    },
    "servers-stop": {
      "en": "Server stop",
      "ru": "Остановка серверов"
    },
