{
  "contractVersion": "0.16.0",
  "targetRelease": "0.3.10",
  "endpoints": [
    {
      "name": "local",
      "syntax": "./path, /absolute/path, or an explicit Windows path"
    },
    {
      "name": "ssh",
      "syntax": "[user@]host:/path or [user@]host:C:/path"
    },
    {
      "name": "web",
      "syntax": "web://"
    },
    {
      "name": "webhook",
      "syntax": "webhook://"
    },
    {
      "name": "http",
      "syntax": "http://host/path or https://host/path"
    }
  ],
  "commands": [
    {
      "name": "from",
      "path": "from",
      "usage": "courier from \u003csource\u003e to \u003cdestination\u003e [options]",
      "system": false,
      "arguments": [
        {
          "name": "source",
          "kind": "endpoint",
          "required": true,
          "description": {
            "en": "File, directory, browser upload, or webhook input to read from.",
            "ru": "Файл, каталог, браузерная загрузка или webhook, откуда получать данные."
          }
        },
        {
          "name": "destination",
          "kind": "endpoint",
          "required": true,
          "prefix": "to",
          "description": {
            "en": "Path, browser download, or HTTP endpoint that receives the data.",
            "ru": "Путь, браузерная выдача или HTTP-адрес, куда передаются данные."
          }
        }
      ],
      "flags": [
        "archive",
        "extract",
        "listen",
        "background",
        "force-source-creation",
        "auth",
        "auth-attempts",
        "auth-fail-action",
        "limit",
        "no-ui",
        "allow-ip",
        "exclude",
        "exclude-regex",
        "exclude-from",
        "max-file-size",
        "max-extracted-size",
        "upload-rate",
        "download-rate"
      ]
    },
    {
      "name": "servers",
      "path": "servers",
      "usage": "courier servers",
      "system": false,
      "arguments": [],
      "flags": null
    },
    {
      "name": "servers-stop",
      "path": "servers stop",
      "usage": "courier servers stop \u003cuuid\u003e|--all",
      "system": false,
      "arguments": [
        {
          "name": "uuid",
          "kind": "uuid",
          "required": true,
          "omitWhenFlag": "all",
          "description": {
            "en": "Delivery or server UUID to stop; omitted when --all is used.",
            "ru": "UUID доставки или сервера для остановки; не указывается вместе с --all."
          }
        }
      ],
      "flags": [
        "all"
      ]
    },
    {
      "name": "ui-start",
      "path": "ui start",
      "usage": "courier ui start [options]",
      "system": false,
      "arguments": [],
      "flags": [
        "listen",
        "background"
      ]
    },
    {
      "name": "ui-stop",
      "path": "ui stop",
      "usage": "courier ui stop",
      "system": false,
      "arguments": [],
      "flags": null
    },
    {
      "name": "help",
      "path": "help",
      "usage": "courier help [command]",
      "system": true,
      "arguments": [
        {
          "name": "command",
          "kind": "command-path",
          "required": false,
          "description": {
            "en": "Command path whose detailed help should be shown.",
            "ru": "Путь команды, для которой нужно показать подробную справку."
          }
        }
      ],
      "flags": null
    },
    {
      "name": "version",
      "path": "version",
      "usage": "courier version",
      "system": true,
      "arguments": [],
      "flags": null
    },
    {
      "name": "update",
      "path": "update",
      "usage": "courier update",
      "system": true,
      "arguments": [],
      "flags": null
    }
  ],
  "flags": [
    {
      "name": "archive",
      "syntax": "--archive",
      "valueKind": "boolean",
      "choices": null,
      "placeholder": "",
      "repeatable": false,
      "default": "false",
      "appliesTo": [
        "path-to-path",
        "path-to-web",
        "path-to-http"
      ],
      "conflicts": [
        "extract"
      ],
      "requires": null,
      "required": false,
      "description": {
        "en": "Pack the source into a verified \u003csource-name\u003e.tar.gz before transfer.",
        "ru": "Упаковать источник в проверенный \u003cимя-источника\u003e.tar.gz перед передачей."
      }
    },
    {
      "name": "extract",
      "syntax": "--extract",
      "valueKind": "boolean",
      "choices": null,
      "placeholder": "",
      "repeatable": false,
      "default": "false",
      "appliesTo": [
        "path-to-path",
        "web-to-path",
        "webhook-to-path"
      ],
      "conflicts": [
        "archive"
      ],
      "requires": null,
      "required": false,
      "description": {
        "en": "Safely extract a tar.gz source into the destination root.",
        "ru": "Безопасно распаковать tar.gz в корневой каталог назначения."
      }
    },
    {
      "name": "listen",
      "syntax": "--listen \u003chost:port\u003e",
      "valueKind": "host-port",
      "choices": null,
      "placeholder": "host:port",
      "repeatable": false,
      "default": "127.0.0.1:8080",
      "appliesTo": [
        "web-to-path",
        "path-to-web",
        "webhook-to-path",
        "ui-start"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Bind incoming browser, webhook, or administration traffic to this address.",
        "ru": "Принимать входящий браузерный, webhook- или административный трафик на этом адресе."
      }
    },
    {
      "name": "background",
      "syntax": "--background",
      "valueKind": "boolean",
      "choices": null,
      "placeholder": "",
      "repeatable": false,
      "default": "false",
      "appliesTo": [
        "web-to-path",
        "path-to-web",
        "webhook-to-path",
        "ui-start"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Detach browser downloads, browser uploads, incoming webhooks, or ui start after printing the URL and UUID; the process survives terminal closure until stopped by courier servers stop, courier ui stop, configured stop behavior, a fatal worker failure, or process termination.",
        "ru": "Отсоединить браузерную выдачу, браузерную загрузку, входящий webhook или ui start после вывода URL и UUID; процесс переживает закрытие терминала и работает до courier servers stop, courier ui stop, настроенного условия остановки, критической ошибки worker или завершения процесса."
      }
    },
    {
      "name": "force-source-creation",
      "syntax": "--force-source-creation",
      "valueKind": "boolean",
      "choices": null,
      "placeholder": "",
      "repeatable": false,
      "default": "false",
      "appliesTo": [
        "path-to-path",
        "web-to-path",
        "path-to-web",
        "webhook-to-path",
        "path-to-http"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Create every missing directory endpoint recursively without asking; no other safety confirmation is bypassed.",
        "ru": "Рекурсивно создать все отсутствующие каталоги без запроса; остальные защитные подтверждения не отключаются."
      }
    },
    {
      "name": "auth",
      "syntax": "--auth \u003cnone|basic|password\u003e",
      "valueKind": "enum",
      "choices": [
        "none",
        "basic",
        "password"
      ],
      "placeholder": "none|basic|password",
      "repeatable": false,
      "default": "none",
      "appliesTo": [
        "web-to-path",
        "path-to-web",
        "webhook-to-path",
        "path-to-http"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Choose no authentication, HTTP Basic authentication, or a browser password.",
        "ru": "Выбрать отсутствие аутентификации, HTTP Basic или пароль для браузера."
      }
    },
    {
      "name": "auth-attempts",
      "syntax": "--auth-attempts \u003cN\u003e",
      "valueKind": "unsigned",
      "choices": null,
      "placeholder": "N",
      "repeatable": false,
      "default": "5",
      "appliesTo": [
        "web-to-path",
        "path-to-web",
        "webhook-to-path"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Set how many failed authentication attempts are allowed before the configured action.",
        "ru": "Задать число неудачных попыток входа до выполнения настроенного действия."
      }
    },
    {
      "name": "auth-fail-action",
      "syntax": "--auth-fail-action \u003cban|stop\u003e",
      "valueKind": "enum",
      "choices": [
        "ban",
        "stop"
      ],
      "placeholder": "ban|stop",
      "repeatable": false,
      "default": "ban",
      "appliesTo": [
        "web-to-path",
        "path-to-web",
        "webhook-to-path"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Ban the peer or stop the delivery when the authentication-attempt limit is reached.",
        "ru": "Заблокировать узел или остановить доставку после исчерпания попыток входа."
      }
    },
    {
      "name": "limit",
      "syntax": "--limit \u003cN\u003e",
      "valueKind": "text",
      "choices": null,
      "placeholder": "N|unlimited",
      "repeatable": false,
      "default": "unlimited",
      "appliesTo": [
        "web-to-path",
        "path-to-web",
        "webhook-to-path"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Limit concurrent transfers for a hosted delivery, or allow an unlimited count.",
        "ru": "Ограничить число одновременных передач для hosted-доставки или не задавать предел."
      }
    },
    {
      "name": "no-ui",
      "syntax": "--no-ui",
      "valueKind": "boolean",
      "choices": null,
      "placeholder": "",
      "repeatable": false,
      "default": "false",
      "appliesTo": [
        "path-to-web"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Expose only the versioned browser-delivery data API, without the web interface.",
        "ru": "Открыть только версионированный API браузерной доставки без веб-интерфейса."
      }
    },
    {
      "name": "allow-ip",
      "syntax": "--allow-ip \u003cIP/CIDR\u003e",
      "valueKind": "ip-cidr",
      "choices": null,
      "placeholder": "IP/CIDR",
      "repeatable": true,
      "default": "none",
      "appliesTo": [
        "web-to-path",
        "path-to-web",
        "webhook-to-path"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Allow one peer IP address or CIDR; repeat the option to add more networks.",
        "ru": "Разрешить один IP-адрес или CIDR; повторите параметр для дополнительных сетей."
      }
    },
    {
      "name": "exclude",
      "syntax": "--exclude \u003cpattern\u003e",
      "valueKind": "text",
      "choices": null,
      "placeholder": "pattern",
      "repeatable": true,
      "default": "none",
      "appliesTo": [
        "path-to-path",
        "web-to-path",
        "path-to-web",
        "webhook-to-path",
        "path-to-http"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Exclude paths with an ordered gitignore-style pattern.",
        "ru": "Исключить пути упорядоченным шаблоном в стиле gitignore."
      }
    },
    {
      "name": "exclude-regex",
      "syntax": "--exclude-regex \u003cregex\u003e",
      "valueKind": "regex",
      "choices": null,
      "placeholder": "regex",
      "repeatable": true,
      "default": "none",
      "appliesTo": [
        "path-to-path",
        "web-to-path",
        "path-to-web",
        "webhook-to-path",
        "path-to-http"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Exclude paths matching a Go regular expression.",
        "ru": "Исключить пути, совпадающие с регулярным выражением Go."
      }
    },
    {
      "name": "exclude-from",
      "syntax": "--exclude-from \u003cfile\u003e",
      "valueKind": "path",
      "choices": null,
      "placeholder": "file",
      "repeatable": true,
      "default": "none",
      "appliesTo": [
        "path-to-path",
        "web-to-path",
        "path-to-web",
        "webhook-to-path",
        "path-to-http"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Read ordered gitignore-style exclusion rules from a local file.",
        "ru": "Прочитать упорядоченные правила исключения в стиле gitignore из локального файла."
      }
    },
    {
      "name": "max-file-size",
      "syntax": "--max-file-size \u003csize|unlimited\u003e",
      "valueKind": "quantity",
      "choices": null,
      "placeholder": "size|unlimited",
      "repeatable": false,
      "default": "10GiB",
      "appliesTo": [
        "web-to-path",
        "webhook-to-path"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Set the largest accepted incoming file size, or remove the configurable limit.",
        "ru": "Задать максимальный размер входящего файла или убрать настраиваемый предел."
      }
    },
    {
      "name": "max-extracted-size",
      "syntax": "--max-extracted-size \u003csize|unlimited\u003e",
      "valueKind": "quantity",
      "choices": null,
      "placeholder": "size|unlimited",
      "repeatable": false,
      "default": "100GiB",
      "appliesTo": [
        "path-to-path",
        "web-to-path",
        "webhook-to-path"
      ],
      "conflicts": null,
      "requires": [
        "extract"
      ],
      "required": false,
      "description": {
        "en": "Set the maximum total expanded archive size; requires --extract.",
        "ru": "Задать максимальный суммарный размер распакованных данных; требует --extract."
      }
    },
    {
      "name": "upload-rate",
      "syntax": "--upload-rate \u003crate|unlimited\u003e",
      "valueKind": "rate",
      "choices": null,
      "placeholder": "rate|unlimited",
      "repeatable": false,
      "default": "unlimited",
      "appliesTo": [
        "local-to-ssh",
        "ssh-to-ssh",
        "web-to-path",
        "webhook-to-path",
        "path-to-http"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Limit the aggregate upload rate, or allow an unlimited rate.",
        "ru": "Ограничить суммарную скорость отправки или не задавать предел."
      }
    },
    {
      "name": "download-rate",
      "syntax": "--download-rate \u003crate|unlimited\u003e",
      "valueKind": "rate",
      "choices": null,
      "placeholder": "rate|unlimited",
      "repeatable": false,
      "default": "unlimited",
      "appliesTo": [
        "ssh-to-local",
        "ssh-to-ssh",
        "path-to-web"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Limit the aggregate download rate, or allow an unlimited rate.",
        "ru": "Ограничить суммарную скорость скачивания или не задавать предел."
      }
    },
    {
      "name": "all",
      "syntax": "--all",
      "valueKind": "boolean",
      "choices": null,
      "placeholder": "",
      "repeatable": false,
      "default": "false",
      "appliesTo": [
        "servers-stop"
      ],
      "conflicts": null,
      "requires": null,
      "required": false,
      "description": {
        "en": "Stop every discovered Courier delivery and server instead of one UUID.",
        "ru": "Остановить все найденные доставки и серверы Courier вместо одного UUID."
      }
    }
  ],
  "routes": [
    {
      "name": "path-to-path",
      "source": [
        "local",
        "ssh"
      ],
      "destination": [
        "local",
        "ssh"
      ],
      "allowedFlags": [
        "archive",
        "extract",
        "force-source-creation",
        "exclude",
        "exclude-regex",
        "exclude-from",
        "max-extracted-size",
        "upload-rate",
        "download-rate"
      ]
    },
    {
      "name": "web-to-path",
      "source": [
        "web"
      ],
      "destination": [
        "local",
        "ssh"
      ],
      "allowedFlags": [
        "extract",
        "listen",
        "background",
        "force-source-creation",
        "auth",
        "auth-attempts",
        "auth-fail-action",
        "limit",
        "allow-ip",
        "exclude",
        "exclude-regex",
        "exclude-from",
        "max-file-size",
        "max-extracted-size",
        "upload-rate"
      ]
    },
    {
      "name": "path-to-web",
      "source": [
        "local",
        "ssh"
      ],
      "destination": [
        "web"
      ],
      "allowedFlags": [
        "archive",
        "listen",
        "background",
        "force-source-creation",
        "auth",
        "auth-attempts",
        "auth-fail-action",
        "limit",
        "no-ui",
        "allow-ip",
        "exclude",
        "exclude-regex",
        "exclude-from",
        "download-rate"
      ]
    },
    {
      "name": "webhook-to-path",
      "source": [
        "webhook"
      ],
      "destination": [
        "local",
        "ssh"
      ],
      "allowedFlags": [
        "extract",
        "listen",
        "background",
        "force-source-creation",
        "auth",
        "auth-attempts",
        "auth-fail-action",
        "limit",
        "allow-ip",
        "exclude",
        "exclude-regex",
        "exclude-from",
        "max-file-size",
        "max-extracted-size",
        "upload-rate"
      ]
    },
    {
      "name": "path-to-http",
      "source": [
        "local",
        "ssh"
      ],
      "destination": [
        "http"
      ],
      "allowedFlags": [
        "archive",
        "force-source-creation",
