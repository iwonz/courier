        "web-to-path",
        "path-to-web",
        "webhook-to-path"
      ],
      "conflicts": null,
      "requires": null
    },
    {
      "name": "auth-fail-action",
      "syntax": "--auth-fail-action \u003cban|stop\u003e",
      "valueKind": "enum",
      "choices": [
        "ban",
        "stop"
      ],
      "placeholder": "ban|stop",
      "repeatable": false,
      "default": "ban",
      "appliesTo": [
        "web-to-path",
