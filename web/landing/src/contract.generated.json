{
  "contractVersion": "0.15.0",
  "targetRelease": "0.3.4",
  "endpoints": [
    {
      "name": "local",
      "syntax": "./path, /absolute/path, or an explicit Windows path"
    },
    {
      "name": "ssh",
      "syntax": "[user@]host:/path or [user@]host:C:/path"
    },
    {
      "name": "web",
      "syntax": "web://"
    },
    {
      "name": "webhook",
      "syntax": "webhook://"
    },
    {
      "name": "http",
      "syntax": "http://host/path or https://host/path"
    }
  ],
  "commands": [
    {
      "name": "from",
      "path": "from",
      "usage": "courier from \u003csource\u003e to \u003cdestination\u003e [options]",
      "system": false,
      "arguments": [
        {
          "name": "source",
          "kind": "endpoint",
          "required": true
        },
        {
          "name": "destination",
          "kind": "endpoint",
          "required": true,
          "prefix": "to"
        }
      ],
      "flags": [
        "archive",
        "extract",
        "listen",
        "background",
        "auth",
        "auth-attempts",
        "auth-fail-action",
        "limit",
        "no-ui",
        "allow-ip",
        "exclude",
        "exclude-regex",
        "exclude-from",
        "max-file-size",
        "max-extracted-size",
        "upload-rate",
        "download-rate"
      ]
    },
    {
      "name": "servers",
      "path": "servers",
      "usage": "courier servers",
      "system": false,
      "arguments": [],
      "flags": null
    },
    {
      "name": "servers-stop",
      "path": "servers stop",
      "usage": "courier servers stop \u003cuuid\u003e|--all",
      "system": false,
      "arguments": [
        {
          "name": "uuid",
          "kind": "uuid",
          "required": true,
          "omitWhenFlag": "all"
        }
      ],
      "flags": [
        "all"
      ]
    },
    {
      "name": "ui-start",
      "path": "ui start",
      "usage": "courier ui start [options]",
      "system": false,
      "arguments": [],
      "flags": [
        "listen",
        "background"
      ]
    },
    {
      "name": "ui-stop",
      "path": "ui stop",
      "usage": "courier ui stop",
      "system": false,
      "arguments": [],
      "flags": null
    },
    {
      "name": "help",
      "path": "help",
      "usage": "courier help [command]",
      "system": true,
      "arguments": [
        {
          "name": "command",
          "kind": "command-path",
          "required": false
        }
      ],
      "flags": null
    },
    {
      "name": "version",
      "path": "version",
      "usage": "courier version",
      "system": true,
      "arguments": [],
      "flags": null
    },
    {
      "name": "update",
      "path": "update",
      "usage": "courier update",
      "system": true,
      "arguments": [],
      "flags": null
    }
  ],
  "flags": [
    {
      "name": "archive",
      "syntax": "--archive",
      "valueKind": "boolean",
      "choices": null,
      "placeholder": "",
      "repeatable": false,
      "default": "false",
      "appliesTo": [
        "path-to-path",
        "path-to-web",
        "path-to-http"
      ],
      "conflicts": [
        "extract"
      ],
      "requires": null
    },
    {
      "name": "extract",
      "syntax": "--extract",
      "valueKind": "boolean",
      "choices": null,
      "placeholder": "",
      "repeatable": false,
      "default": "false",
      "appliesTo": [
        "path-to-path",
        "web-to-path",
        "webhook-to-path"
      ],
      "conflicts": [
        "archive"
      ],
      "requires": null
    },
    {
      "name": "listen",
      "syntax": "--listen \u003chost:port\u003e",
      "valueKind": "host-port",
      "choices": null,
      "placeholder": "host:port",
      "repeatable": false,
      "default": "127.0.0.1:8080",
      "appliesTo": [
        "web-to-path",
        "path-to-web",
        "webhook-to-path",
        "ui-start"
      ],
      "conflicts": null,
      "requires": null
    },
    {
      "name": "background",
      "syntax": "--background",
      "valueKind": "boolean",
      "choices": null,
      "placeholder": "",
      "repeatable": false,
      "default": "false",
