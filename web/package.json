{
  "name": "courier-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "build": "npm run build --workspace @courier/ui",
    "check:assets": "npm run check:assets --workspace @courier/ui",
